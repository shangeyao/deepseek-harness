# LDAP 网关环境变量示例。复制为 deploy/.env 后按需修改。

# 网关监听
GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=8080

# 所有用户数据的根目录（每位用户 -> users/<id>/.dsh 与 workspace/）
DSH_DATA_ROOT=/var/lib/calb-dsh

# dsh 可执行文件与 profile
DSH_BIN=dsh
DSH_PROFILE=web
# DSH_PATCH=/absolute/path/to/deploy/profiles/ldap-web.patch.yml

# JWT 签名密钥（生产环境必须设置强随机值）
JWT_SECRET=change-me-in-production
TOKEN_EXPIRY_SECONDS=604800

# 空闲 1 小时后回收用户 dsh 子进程
USER_IDLE_TIMEOUT_MS=3600000

# LDAP（生产）
LDAP_ENABLED=true
LDAP_SERVER_URI=ldap://ldap.example.com:389
LDAP_BASE_DN=dc=example,dc=com
LDAP_BIND_DN=cn=readonly,dc=example,dc=com
LDAP_BIND_PASSWORD=
LDAP_USER_SEARCH_FILTER=(|(mail={username})(uid={username})(sAMAccountName={username}))
LDAP_EMAIL_ATTRIBUTE=mail
LDAP_USE_SSL=false
LDAP_START_TLS=true

# 本地开发（未启用 LDAP 时默认允许）
# DEV_ALLOW_LOCAL_LOGIN=true
# DEV_LOCAL_USERNAME=admin
# DEV_LOCAL_PASSWORD=admin
