{
  "name": "@shangeyao/dsh-calb-plugin",
  "version": "0.3.3",
  "description": "CALB 多租户 dsh 插件包：LDAP 网关 + LDAP 租户对齐的 WeKnora 检索",
  "type": "module",
  "exports": {
    ".": "./dist/index.js",
    "./client": "./dist/client.js",
    "./weknora": "./dist/weknora/index.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "dist/index.js",
    "dist/client.js",
    "dist/weknora",
    "shared-models/dist",
    "account-ui/dist",
    "gateway/lib",
    "gateway/public",
    "cordis.patch.yml",
    "README.zh.md",
    ".npmrc"
  ],
  "bin": {
    "calb-gateway": "gateway/lib/index.js"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "scripts": {
    "build": "npm run build --prefix shared-models && npm run build --prefix account-ui && tsc -p weknora/tsconfig.json && node build-host.mjs && node build-client.mjs && tsc -p gateway/tsconfig.json",
    "prepublishOnly": "npm run build",
    "start": "node gateway/lib/index.js",
    "typecheck": "tsc -p weknora/tsconfig.json --noEmit && tsc -p gateway/tsconfig.json --noEmit",
    "test": "tsc -p gateway/tsconfig.json && node --test gateway/tests/*.test.js"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shangeyao/CALB-AIStudio.git",
    "directory": "deploy/dsh-calb-plugin"
  },
  "license": "MIT",
  "dependencies": {
    "@wxg-prc-cpg/dsh-weknora": "^0.1.0",
    "dotenv": "^16.6.1",
    "ldapts": "^8.0.9",
    "yaml": "^2.8.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "esbuild": "^0.25.12",
    "typescript": "^5.8.3"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "remote",
        "slots",
        "locale"
      ]
    }
  }
}
