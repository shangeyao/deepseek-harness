# CALB dsh-calb-plugin 网关环境变量。复制为 deploy/dsh-calb-plugin/.env 后按需修改。

# 网关监听（局域网部署用 0.0.0.0；仅本机开发可设 127.0.0.1）
GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=8080

# HTTPS 前置代理后启用 Secure Cookie
# COOKIE_SECURE=true

# 局域网 / 内网 DNS 主机名，逗号分隔，写入每个用户 dsh 的 trustedHosts
# CALB_TRUSTED_HOSTS=calb-ai.local,10.0.0.12

# 所有用户数据的根目录（每位用户 -> users/<id>/.dsh 与 workspace/）
DSH_DATA_ROOT=/var/lib/calb-dsh

# dsh 可执行文件与 profile
DSH_BIN=dsh
DSH_PROFILE=web
# DSH_CALB_PLUGIN_ROOT=/absolute/path/to/deploy/dsh-calb-plugin

# 平台超级管理员（邮箱与 LDAP 组取并集）
# CALB_SUPER_ADMIN_EMAIL=admin@company.com
# CALB_LDAP_SUPER_ADMIN_GROUPS=CN=CALB-AI-Admins,OU=Groups,DC=calb,DC=com
# CALB_LDAP_ADMIN_GROUPS=CN=CALB-AI-Ops,OU=Groups,DC=calb,DC=com
# CALB_LDAP_READONLY_GROUPS=CN=CALB-AI-Viewers,OU=Groups,DC=calb,DC=com

# WeKnora 知识库按组织/组分配（JSON 对象；group 映射优先于 department）
# CALB_WEKNORA_KB_MAP={"研发部":["kb-rd"],"制造部":["kb-mfg"],"default":["kb-common"]}
# CALB_WEKNORA_KB_GROUP_MAP={"CN=Exec,OU=Groups,DC=calb,DC=com":["kb-exec"]}

# JWT 签名密钥（生产环境必须设置强随机值）
JWT_SECRET=change-me-in-production
TOKEN_EXPIRY_SECONDS=604800

# 空闲 1 小时后回收用户 dsh 子进程
USER_IDLE_TIMEOUT_MS=3600000

# WeKnora（平台级 API Key；KB 列表可由上方映射覆盖）
WEKNORA_BASE_URL=http://localhost:8080/api/v1
WEKNORA_API_KEY=sk-platform-weknora-key
# WEKNORA_KNOWLEDGE_BASE_IDS=kb-common
# WEKNORA_AGENT_ID=

# LDAP（生产）
LDAP_ENABLED=true
LDAP_SERVER_URI=ldap://ldap.example.com:389
LDAP_BASE_DN=dc=example,dc=com
LDAP_BIND_DN=cn=readonly,dc=example,dc=com
LDAP_BIND_PASSWORD=
LDAP_USER_SEARCH_FILTER=(|(mail={username})(uid={username})(sAMAccountName={username}))
LDAP_EMAIL_ATTRIBUTE=mail
LDAP_GROUP_ATTRIBUTE=memberOf
LDAP_DEPARTMENT_ATTRIBUTE=department
# CALB_ORG_ID_ATTRIBUTE=company

LDAP_USE_SSL=false
LDAP_START_TLS=true

# 本地开发（未启用 LDAP 时默认允许）
# DEV_ALLOW_LOCAL_LOGIN=true
# DEV_LOCAL_USERNAME=admin
# DEV_LOCAL_PASSWORD=admin
# DEV_LOCAL_DEPARTMENT=Development
# DEV_LOCAL_COMPANY=CALB
# DEV_LOCAL_GROUPS=CN=CALB-AI-Admins,OU=Groups,DC=calb,DC=com
